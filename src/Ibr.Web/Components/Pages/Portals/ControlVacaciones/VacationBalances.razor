@page "/control-vacaciones/planificacion"
@layout PortalLayout
@attribute [Authorize]
@using System.Globalization
@using System.Text
@using Ibr.Application.Vacations
@inject IVacationTeamService TeamService
@inject IJSRuntime JS
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Planificación de vacaciones</PageTitle>

<nav class="ibr-breadcrumb" aria-label="Ruta">
    <a href="/dashboard">Portales</a><RadzenIcon Icon="chevron_right" /><span>Control de vacaciones</span><RadzenIcon Icon="chevron_right" /><span>Planificación de vacaciones</span>
</nav>

<PageHeader Eyebrow="Control de vacaciones" Title="Planificación de Vacaciones" Subtitle="Días pendientes y próximos a vencer según el cálculo FIFO.">
    <Actions>
        <RadzenButton Text="Exportar a Excel" Icon="download" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@ExportCsvAsync" Disabled="@(loading || Visible.Count == 0)" />
    </Actions>
</PageHeader>

<RadzenTabs>
    <Tabs>
        <RadzenTabsItem Text="Estado Actual">
            <div class="ibr-card">
                <div class="ibr-filterbar">
                    <div class="ibr-field">
                        <label class="ibr-field__label">Buscar colaborador</label>
                        <RadzenTextBox @bind-Value="searchTerm" Immediate="true" Placeholder="Nombre o correo…" />
                    </div>
                    <div class="ibr-field" style="max-width:220px">
                        <label class="ibr-field__label">Nivel de riesgo</label>
                        <RadzenDropDown @bind-Value="riskFilter" Data="@RiskOptions" TextProperty="Label" ValueProperty="Value" style="width:100%" />
                    </div>
                </div>
            </div>

            @if (loading)
            {
                <div class="ibr-skeleton" style="min-height:340px"></div>
            }
            else
            {
                <div class="ibr-card ibr-card--flush">
                    <div class="ibr-card__toolbar">
                        <span class="ibr-card__toolbar-meta">@Visible.Count de @balances.Count colaboradores</span>
                    </div>
                    <RadzenDataGrid TItem="VacationBalanceDto" Data="@Visible" AllowPaging="true" AllowSorting="true" PageSize="12"
                                    PagerHorizontalAlign="HorizontalAlign.Right" ShowPagingSummary="true" PagingSummaryFormat="Página {0} de {1}"
                                    RowRender="HighlightRisk">
                        <EmptyTemplate>
                            <div class="ibr-empty">
                                <RadzenIcon Icon="search_off" />
                                <strong>Sin resultados</strong>
                                <span>Ningún colaborador coincide con la búsqueda o el filtro de riesgo.</span>
                            </div>
                        </EmptyTemplate>
                        <Columns>
                            <RadzenDataGridColumn TItem="VacationBalanceDto" Title="Colaborador" Property="FullName" MinWidth="260px">
                                <Template Context="row">
                                    <div class="ibr-cell-primary">
                                        <Avatar Name="@row.FullName" />
                                        <div>
                                            <div class="ibr-balance-name">
                                                @row.FullName
                                                @if (row.HasActiveRequests)
                                                {
                                                    <span class="ibr-active-check" title="Tiene solicitudes en curso">
                                                        <RadzenIcon Icon="check_circle" />
                                                    </span>
                                                }
                                                @if (row.RequiresAudit)
                                                {
                                                    <span class="ibr-audit-warning" title="Tiene una solicitud borrada en Buk: requiere auditoría">
                                                        <RadzenIcon Icon="error" />
                                                    </span>
                                                }
                                            </div>
                                            <div class="ibr-balance-email">@row.Email</div>
                                        </div>
                                    </div>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="VacationBalanceDto" Title="Pendientes" Property="DaysPending" Width="110px" TextAlign="TextAlign.Right">
                                <Template Context="row">
                                    <strong>@VacationUi.Days(row.DaysPending)</strong>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="VacationBalanceDto" Title="Próx. a vencer" Property="DaysSoonToExpire" Width="130px" TextAlign="TextAlign.Right">
                                <Template Context="row">
                                    @if (row.DaysSoonToExpire > 0)
                                    {
                                        <span style="color:#B45309;font-weight:700">@VacationUi.Days(row.DaysSoonToExpire)</span>
                                    }
                                    else
                                    {
                                        <span class="ibr-text-muted">0</span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="VacationBalanceDto" Title="Vencimiento" Property="NextExpiration" Width="120px">
                                <Template Context="row">@VacationUi.Date(row.NextExpiration)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="VacationBalanceDto" Title="Riesgo" Property="RiskLevel" Width="120px">
                                <Template Context="row">
                                    <span class="ibr-badge ibr-badge--@VacationUi.Risk(row.RiskLevel).BadgeClass">@VacationUi.Risk(row.RiskLevel).Label</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="VacationBalanceDto" Width="64px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                                <Template Context="row">
                                    <button type="button" class="ibr-detail-btn" title="Ver detalle de @row.FullName" aria-label="Ver detalle de @row.FullName"
                                            @onclick="() => OpenDetailAsync(row)">
                                        @UserScanIcon
                                    </button>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
            }
        </RadzenTabsItem>
        <RadzenTabsItem Text="Matriz de Planificación">
            @if (loading)
            {
                <div class="ibr-skeleton" style="min-height:340px"></div>
            }
            else if (matriz is null || matriz.Rows.Count == 0)
            {
                <div class="ibr-card">
                    <div class="ibr-empty">
                        <RadzenIcon Icon="grid_4x4" />
                        <strong>Sin colaboradores</strong>
                        <span>Tu equipo está vacío o no tienes empleados asociados.</span>
                    </div>
                </div>
            }
            else
            {
                <div class="ibr-card ibr-card--flush">
                    <div class="ibr-card__toolbar ibr-matrix__toolbar">
                        <div class="ibr-matrix__filters">
                            <RadzenTextBox @bind-Value="matrixSearch" Immediate="true" Placeholder="Buscar colaborador…" aria-label="Buscar colaborador en la matriz" style="width:260px;max-width:100%" />
                            <div class="ibr-matrix__toggle">
                                <RadzenSwitch @bind-Value="onlyAlerts" Name="matrixOnlyAlerts" />
                                <RadzenLabel Text="Solo con días por vencer sin plan" Component="matrixOnlyAlerts" />
                            </div>
                        </div>
                        <span class="ibr-card__toolbar-meta">@MatrixRows.Count de @matriz.Rows.Count colaboradores · @(matriz.Months[0].Label) a @(matriz.Months[^1].Label)</span>
                    </div>
                    <div class="ibr-matrix__legend" aria-label="Leyenda">
                        <span class="ibr-matrix__legend-item"><span class="ibr-swatch ibr-swatch--buk"></span>Registrada en Buk</span>
                        <span class="ibr-matrix__legend-item"><span class="ibr-swatch ibr-swatch--plan"></span>Plan del jefe (pendiente en Buk)</span>
                        <span class="ibr-matrix__legend-item"><span class="ibr-swatch ibr-swatch--consolidado"></span>Confirmado (plan = Buk)</span>
                        <span class="ibr-matrix__legend-item"><span class="ibr-swatch ibr-swatch--vencen"></span>Días que vencen sin plan</span>
                        <span class="ibr-matrix__legend-hint"><RadzenIcon Icon="info" />Pasa el mouse sobre un bloque para ver su estado en Buk · «Planificar» en cada celda crea un plan</span>
                    </div>
                    <div class="ibr-matrix-scroll">
                        <table class="ibr-matrix">
                            <thead>
                                <tr>
                                    <th class="ibr-matrix__fix ibr-matrix__fix--name">Colaborador</th>
                                    <th class="ibr-matrix__fix ibr-matrix__fix--saldo">Saldo</th>
                                    <th class="ibr-matrix__fix ibr-matrix__fix--vence">Próx. vencimiento</th>
                                    @foreach (var month in Months)
                                    {
                                        var alerts = MonthAlerts(month);
                                        <th class="ibr-matrix__month @(IsCurrent(month) ? "is-current" : null)">
                                            <div class="ibr-matrix__month-head">
                                                <span class="ibr-matrix__month-label">@month.Label</span>
                                                @if (IsCurrent(month))
                                                {
                                                    <span class="ibr-matrix__current">Mes actual</span>
                                                }
                                            </div>
                                            @if (alerts > 0)
                                            {
                                                <span class="ibr-matrix__alert" title="@($"{alerts} colaboradores con días por vencer sin planificación este mes")"><RadzenIcon Icon="warning" />@alerts sin plan</span>
                                            }
                                            else
                                            {
                                                <span class="ibr-matrix__ok"><RadzenIcon Icon="check" />Sin alertas</span>
                                            }
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (MatrixRows.Count == 0)
                                {
                                    <tr>
                                        <td class="ibr-matrix__empty" colspan="@(Months.Count + 3)">
                                            <div class="ibr-empty">
                                                <RadzenIcon Icon="search_off" />
                                                <strong>Sin resultados</strong>
                                                <span>Ningún colaborador coincide con la búsqueda o el filtro.</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @foreach (var row in MatrixRows)
                                {
                                    <tr class="@RowClass(row)">
                                        <td class="ibr-matrix__fix ibr-matrix__fix--name">
                                            <div class="ibr-matrix__who">
                                                <Avatar Name="@row.FullName" />
                                                <div class="ibr-matrix__who-text">
                                                    <div class="ibr-matrix__name-line">
                                                        <span class="ibr-matrix__name" title="@row.FullName">@row.FullName</span>
                                                        @if (row.IsBoss)
                                                        {
                                                            <em class="ibr-matrix__boss">Tú</em>
                                                        }
                                                        @if (row.HasActiveRequests)
                                                        {
                                                            <span class="ibr-active-check" title="Tiene solicitudes en curso"><RadzenIcon Icon="check_circle" /></span>
                                                        }
                                                        @if (row.RequiresAudit)
                                                        {
                                                            <span class="ibr-audit-warning" title="Tiene una solicitud borrada en Buk: requiere auditoría"><RadzenIcon Icon="error" /></span>
                                                        }
                                                    </div>
                                                    <span class="ibr-matrix__email" title="@row.Email">@row.Email</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="ibr-matrix__fix ibr-matrix__fix--saldo">
                                            <span class="ibr-matrix__saldo">@VacationUi.Days(row.DaysPending)</span>
                                            <span class="ibr-matrix__unit">días</span>
                                        </td>
                                        <td class="ibr-matrix__fix ibr-matrix__fix--vence">
                                            <span class="ibr-matrix__date">@VacationUi.Date(row.NextExpiration)</span>
                                            @if (row.NextExpiration is not null)
                                            {
                                                var (text, tone) = ExpiresIn(row.NextExpiration.Value);
                                                <span class="ibr-matrix__relative ibr-matrix__relative--@tone">@text</span>
                                            }
                                        </td>
                                        @foreach (var month in Months)
                                        {
                                            var blocks = BlocksFor(row, month);
                                            var expiring = ExpirationDays(row, month);
                                            <td class="ibr-matrix__month @(IsCurrent(month) ? "is-current" : null)">
                                                @foreach (var block in blocks)
                                                {
                                                    <MatrixBlock @key="@($"{block.Kind}-{block.PlanId}-{block.VacationId}")" Block="@block" OnDeletePlan="@(item => DeletePlanAsync(row, item))" />
                                                }
                                                @if (expiring > 0)
                                                {
                                                    if (blocks.Count == 0)
                                                    {
                                                        <div class="ibr-block ibr-block--vencen" title="Días que vencen este mes sin plan ni solicitud">
                                                            <span class="ibr-block__kind"><RadzenIcon Icon="warning" />Vencen @VacationUi.Days(expiring) d</span>
                                                            <span class="ibr-block__dates">Sin planificación</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="ibr-matrix__note" title="Días con saldo FIFO que vencen este mes">
                                                            <RadzenIcon Icon="schedule" />@VacationUi.Days(expiring) d vencen este mes
                                                        </div>
                                                    }
                                                }
                                                <button type="button" class="ibr-matrix__add" @onclick="() => OpenPlanAsync(row, month)"
                                                        title="@($"Planificar vacaciones de {row.FullName} en {month.Label}")">
                                                    <RadzenIcon Icon="add" />Planificar
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                            @if (MatrixRows.Count > 0)
                            {
                                <tfoot>
                                    <tr>
                                        <td class="ibr-matrix__fix ibr-matrix__fix--foot" colspan="3">Resumen del mes</td>
                                        @foreach (var month in Months)
                                        {
                                            var planned = MatrixRows.Count(row => BlocksFor(row, month).Count > 0);
                                            var expiring = MatrixRows.Sum(row => ExpirationDays(row, month));
                                            <td class="ibr-matrix__month @(IsCurrent(month) ? "is-current" : null)">
                                                <div class="ibr-matrix__sum"><strong>@planned</strong> con vacaciones</div>
                                                <div class="ibr-matrix__sum @(expiring > 0 ? "ibr-matrix__sum--danger" : null)"><strong>@VacationUi.Days(expiring)</strong> d vencen</div>
                                            </td>
                                        }
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
            }
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {
    private sealed record RiskOption(string Value, string Label);

    private static readonly IReadOnlyList<RiskOption> RiskOptions =
    [
        new("all", "Todos"),
        new("normal", "Normal"),
        new("alerta", "Alerta"),
        new("critico", "Crítico"),
        new("vencido", "Vencido")
    ];

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;

    private IReadOnlyList<VacationBalanceDto> balances = [];
    private VacationMatrizDto? matriz;
    private bool loading = true;
    private string searchTerm = string.Empty;
    private string riskFilter = "all";
    private string matrixSearch = string.Empty;
    private bool onlyAlerts;
    private int bossEmployeeId;

    private static readonly MarkupString UserScanIcon = new(
        """<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-user-scan"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 9a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"/><path d="M8 16a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2"/><path d="M3 7v-2a2 2 0 0 1 2 -2h2"/><path d="M3 17v2a2 2 0 0 0 2 2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M17 21h2a2 2 0 0 0 2 -2v-2"/></svg>""");

    private Task OpenDetailAsync(VacationBalanceDto row) =>
        DialogService.OpenAsync<CollaboratorDetailDialog>(
            $"Detalle de {row.FullName}",
            new Dictionary<string, object?>
            {
                [nameof(CollaboratorDetailDialog.EmployeeId)] = row.EmployeeId,
                [nameof(CollaboratorDetailDialog.BossEmployeeId)] = bossEmployeeId,
                [nameof(CollaboratorDetailDialog.OnChanged)] = EventCallback.Factory.Create(this, LoadAsync)
            },
            new DialogOptions { Width = "min(1080px, 96vw)", Resizable = true, Draggable = true, ShowClose = true, CssClass = "ibr-dialog" });

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            var user = (await AuthState).User;
            bossEmployeeId = user.GetEmployeeId();
            balances = await TeamService.GetBalancesAsync(bossEmployeeId, unrestricted: false);
            matriz = await TeamService.GetMatrizAsync(bossEmployeeId, unrestricted: false);
        }
        finally
        {
            loading = false;
        }
    }

    private IReadOnlyList<VacationBalanceDto> Visible => balances
        .Where(balance => riskFilter == "all" || balance.RiskLevel == riskFilter)
        .Where(MatchesSearch)
        .ToList();

    private bool MatchesSearch(VacationBalanceDto balance) => MatchesTerm($"{balance.FullName} {balance.Email}", searchTerm);

    private static bool MatchesTerm(string haystack, string term)
    {
        if (string.IsNullOrWhiteSpace(term)) return true;
        return term
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .All(part => haystack.Contains(part, StringComparison.OrdinalIgnoreCase));
    }

    private void HighlightRisk(RowRenderEventArgs<VacationBalanceDto> args)
    {
        if (args.Data is VacationBalanceDto { RiskLevel: "critico" or "vencido" })
        {
            args.Attributes["class"] = "ibr-row--risk";
        }
    }

    private async Task ExportCsvAsync()
    {
        var builder = new StringBuilder();
        builder.AppendLine("Colaborador;Correo;Días pendientes;Próximos a vencer;Vencimiento;Riesgo;Solicitudes en curso;Requiere auditoría");
        foreach (var row in Visible)
        {
            builder.AppendLine(string.Join(';',
                Csv(row.FullName), Csv(row.Email),
                row.DaysPending.ToString("0.##", CultureInfo.InvariantCulture),
                row.DaysSoonToExpire.ToString("0.##", CultureInfo.InvariantCulture),
                VacationUi.Date(row.NextExpiration),
                VacationUi.Risk(row.RiskLevel).Label,
                row.HasActiveRequests ? "Sí" : "No",
                row.RequiresAudit ? "Sí" : "No"));
        }

        var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(builder.ToString())).ToArray();
        await JS.InvokeVoidAsync("ibrExport.csv", "planificacion-vacaciones.csv", Convert.ToBase64String(bytes));
        NotificationService.Notify(NotificationSeverity.Success, "Exportación lista", $"{Visible.Count} registros en planificacion-vacaciones.csv.");
    }

    private static string Csv(string value) =>
        value.Contains(';', StringComparison.Ordinal) ? $"\"{value.Replace("\"", "\"\"")}\"" : value;

    // ---------- Matriz de planificación ----------

    private IReadOnlyList<VacationMatrizMonthDto> Months => matriz?.Months ?? [];

    private static (DateOnly Start, DateOnly End) MonthRange(VacationMatrizMonthDto month)
    {
        var start = new DateOnly(month.Year, month.Month, 1);
        return (start, start.AddMonths(1).AddDays(-1));
    }

    private static List<VacationMatrizBlockDto> BlocksFor(VacationMatrizRowDto row, VacationMatrizMonthDto month)
    {
        var (start, end) = MonthRange(month);
        return row.Blocks.Where(block => block.StartDate <= end && block.EndDate >= start).ToList();
    }

    private static decimal ExpirationDays(VacationMatrizRowDto row, VacationMatrizMonthDto month) =>
        row.Expirations.Where(expiration => expiration.Year == month.Year && expiration.Month == month.Month)
            .Sum(expiration => expiration.Days);

    private IReadOnlyList<VacationMatrizRowDto> MatrixRows => (matriz?.Rows ?? [])
        .Where(row => !onlyAlerts || Months.Any(month => HasAlert(row, month)))
        .Where(row => MatchesTerm($"{row.FullName} {row.Email}", matrixSearch))
        .ToList();

    private static bool HasAlert(VacationMatrizRowDto row, VacationMatrizMonthDto month) =>
        ExpirationDays(row, month) > 0 && BlocksFor(row, month).Count == 0;

    private int MonthAlerts(VacationMatrizMonthDto month) => MatrixRows.Count(row => HasAlert(row, month));

    private static bool IsCurrent(VacationMatrizMonthDto month) =>
        month.Year == DateTime.Today.Year && month.Month == DateTime.Today.Month;

    private string? RowClass(VacationMatrizRowDto row)
    {
        var classes = new List<string>(2);
        if (row.IsBoss) classes.Add("ibr-matrix__row--boss");
        if (Months.Any(month => HasAlert(row, month))) classes.Add("ibr-matrix__row--alert");
        return classes.Count == 0 ? null : string.Join(' ', classes);
    }

    private static (string Text, string Tone) ExpiresIn(DateOnly date)
    {
        var days = date.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;
        return days switch
        {
            < 0 => ($"Venció hace {-days} d", "danger"),
            0 => ("Vence hoy", "danger"),
            <= 30 => ($"En {days} días", "orange"),
            <= 60 => ($"En {days} días", "warning"),
            _ => ($"En {days / 30} meses", "muted")
        };
    }

    private async Task OpenPlanAsync(VacationMatrizRowDto row, VacationMatrizMonthDto month)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var (monthStart, _) = MonthRange(month);
        var saved = await DialogService.OpenAsync<VacationPlanDialog>(
            $"Planificar vacaciones · {row.FullName}",
            new Dictionary<string, object?>
            {
                [nameof(VacationPlanDialog.EmployeeId)] = row.EmployeeId,
                [nameof(VacationPlanDialog.EmployeeName)] = row.FullName,
                [nameof(VacationPlanDialog.BossEmployeeId)] = bossEmployeeId,
                [nameof(VacationPlanDialog.InitialStart)] = monthStart > today ? monthStart : today
            },
            new DialogOptions { Width = "min(480px, 94vw)", ShowClose = true, Draggable = true, CssClass = "ibr-dialog" });

        if (saved is true)
        {
            NotificationService.Notify(NotificationSeverity.Success, "Plan registrado", $"Vacaciones de {row.FullName} planificadas en estado Pendiente.");
            await LoadAsync();
        }
    }

    private async Task DeletePlanAsync(VacationMatrizRowDto row, VacationMatrizBlockDto block)
    {
        if (block.PlanId is not { } planId) return;

        var confirmed = await DialogService.Confirm(
            $"¿Eliminar el plan de {row.FullName} del {VacationUi.Date(block.StartDate)} al {VacationUi.Date(block.EndDate)}?",
            "Eliminar plan",
            new ConfirmOptions { OkButtonText = "Eliminar", CancelButtonText = "Cancelar", CssClass = "ibr-dialog" });
        if (confirmed is not true) return;

        var result = await TeamService.EliminarPlanAsync(bossEmployeeId, planId, unrestricted: false);
        if (result.Succeeded)
        {
            NotificationService.Notify(NotificationSeverity.Success, "Plan eliminado", $"Se eliminó el plan de {row.FullName}.");
            await LoadAsync();
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Error, "No se pudo eliminar", result.Error ?? "Inténtalo nuevamente.");
        }
    }
}
