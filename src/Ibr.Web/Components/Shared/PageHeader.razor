<header class="ibr-page-header">
    <div>
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <p class="ibr-page-header__eyebrow">@Eyebrow</p>
        }
        <h1 class="ibr-page-header__title">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="ibr-page-header__subtitle">@Subtitle</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="ibr-page-header__actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
